{
  "compilerOptions": {
    "target": "ES2021",
    "lib": ["ES2021", "ES2022.Error"],
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": ["worker/**/*.ts"],
  "exclude": ["worker/**/*.test.ts"]
}
