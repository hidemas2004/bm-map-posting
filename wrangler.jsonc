{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bm-map-posting",
  "compatibility_date": "2026-07-26",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  }
  // 対象地域表示名・地図初期中心座標・初期ズームレベル等の環境変数、
  // D1バインディング、e-Stat関連のSecretsは後続フェーズで追加する。
}
