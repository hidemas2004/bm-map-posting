{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bm-map-posting",
  "compatibility_date": "2026-07-26",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // トップレベルは全env共通の土台（main/compatibility_date/assets）のみを持つ。
  // d1_databasesを含む実際のデプロイ対象は必ず env.<地域ID> として追加する
  // （`wrangler dev`/`wrangler deploy` を --env 無しで実行すると DB バインディングが無く
  // 意図的に失敗する。「無名のデフォルト環境」は存在しない設計。詳細はREADME「複数地域の並行運用」）。
  "env": {
    "staging": {
      "name": "bm-map-posting-staging",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "bm-posting-db-staging",
          "database_id": "972ced08-252f-46f2-b143-040ada84c6b0"
        }
      ],
      "r2_buckets": [
        {
          "binding": "COMMENT_IMAGES",
          "bucket_name": "bm-posting-comment-images-staging"
        }
      ],
      "vars": {
        "REGION_ID": "14213-yamato",
        "REGION_DISPLAY_NAME": "大和市",
        "MAP_CENTER_LAT": 35.4717,
        "MAP_CENTER_LNG": 139.4549,
        "MAP_ZOOM": 13,
        "HAS_CHOME_BOUNDARY": true
      }
    },
    "14213-yamato": {
      "name": "bm-map-posting-14213-yamato",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "bm-posting-db-14213-yamato",
          "database_id": "33663a66-7b1e-4bf4-952d-d77c2b8ab852"
        }
      ],
      "r2_buckets": [
        {
          "binding": "COMMENT_IMAGES",
          "bucket_name": "bm-posting-comment-images-14213-yamato"
        }
      ],
      "vars": {
        "REGION_ID": "14213-yamato",
        "REGION_DISPLAY_NAME": "大和市",
        "MAP_CENTER_LAT": 35.4717,
        "MAP_CENTER_LNG": 139.4549,
        "MAP_ZOOM": 13,
        "HAS_CHOME_BOUNDARY": true
      }
    },
    "14206-odawara": {
      "name": "bm-map-posting-14206-odawara",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "bm-posting-db-14206-odawara",
          "database_id": "99601ab9-bf43-4b04-9703-61e9a08d3e08"
        }
      ],
      "r2_buckets": [
        {
          "binding": "COMMENT_IMAGES",
          "bucket_name": "bm-posting-comment-images-14206-odawara"
        }
      ],
      "vars": {
        "REGION_ID": "14206-odawara",
        "REGION_DISPLAY_NAME": "小田原市",
        "MAP_CENTER_LAT": 35.254,
        "MAP_CENTER_LNG": 139.1489,
        "MAP_ZOOM": 13,
        "HAS_CHOME_BOUNDARY": true
      }
    },
    "14203-hiratsuka": {
      "name": "bm-map-posting-14203-hiratsuka",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "bm-posting-db-14203-hiratsuka",
          "database_id": "c08e0625-f148-4455-ae70-0e519505ecb0"
        }
      ],
      "r2_buckets": [
        {
          "binding": "COMMENT_IMAGES",
          "bucket_name": "bm-posting-comment-images-14203-hiratsuka"
        }
      ],
      "vars": {
        "REGION_ID": "14203-hiratsuka",
        "REGION_DISPLAY_NAME": "平塚市",
        "MAP_CENTER_LAT": 35.3579,
        "MAP_CENTER_LNG": 139.307,
        "MAP_ZOOM": 13,
        "HAS_CHOME_BOUNDARY": true
      }
    }
  }
}
